# Copie este arquivo para .env e preencha com os valores reais.
# O .env NUNCA vai pro Git — está no .gitignore e deve continuar lá.
#
#   cp .env.example .env
#
# Se precisar de uma variável nova, adicione aqui com valor FALSO
# e no .env com o valor real. Nunca o contrário.
#
# Existem três arquivos de ambiente, e cada um tem um dono:
#   .env          — desenvolvimento, aponta pro Supabase local em Docker
#   .env.producao — projeto Supabase na nuvem (só as chaves do Supabase)
#   .env.local    — carregado pelo Next com PRIORIDADE sobre o .env.
#                   Não repita variável aqui: ela vence a do .env calada.


# ---------- Supabase ----------
# Painel do Supabase > Project Settings > API.
# Em desenvolvimento, estes valores saem de `pnpm db:status`.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_aqui_a_anon_key

# NUNCA exponha a service role no navegador.
# Só use em Edge Function ou rota de servidor.
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_service_role_key


# ---------- IDs de afiliado ----------
# Isto é dinheiro. Se vazar, outra pessoa usa os seus links.
AFILIADO_MERCADO_LIVRE=seu_id_aqui
AFILIADO_AMAZON=seu_id_aqui
AFILIADO_SHOPEE=seu_id_aqui


# ---------- Mercado Livre: API de itens ----------
# Aplicação criada em developers.mercadolivre.com.br. É Mercado LIVRE,
# não Mercado Pago. O access token dura poucas horas, por isso o sistema
# guarda o refresh token e renova sozinho — e ele É TROCADO A CADA
# RENOVAÇÃO. Ver docs/credenciais.md §4b.
ML_CLIENT_ID=0000000000000000
ML_CLIENT_SECRET=cole_aqui_a_chave_secreta
ML_REFRESH_TOKEN=cole_aqui_o_refresh_token


# Identificador da ferramenta de afiliado, que vai em `matt_tool` no
# link publicado. Sai do link gerado pelo painel de afiliados — é por
# conta, não é global. Sem ele o link sai SEM COMISSÃO.
ML_MATT_TOOL=00000000


# ---------- Shopee: Open API de afiliado ----------
# Painel de afiliado da Shopee. Esta credencial resolve dado de
# produto e link curto de uma vez.
SHOPEE_APP_ID=0000000000
SHOPEE_APP_SECRET=cole_aqui_o_app_secret

# ---------- IA do gancho (migration 64) ----------
# A primeira linha do post, escrita pelo Gemini. Sai do AI Studio.
# Sem ela nenhum gancho é escrito e o post sai como sempre saiu: o
# recurso degrada, não quebra. Onde ele vale é decidido no banco, por
# `modelo_mensagem.instrucao_gancho`, e o freio geral é o parâmetro
# `ia_gancho`.
GEMINI_API_KEY=cole_aqui_a_chave_do_ai_studio


# ---------- Telegram: bot que publica ----------
# Token gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA


# ---------- Telegram: colheita de canais de terceiros ----------
# Conta de usuário do Telegram, com NÚMERO DEDICADO — nunca o seu
# pessoal. Ela só lê: nunca publica, nunca responde.
# api_id e api_hash saem de my.telegram.org.
TELEGRAM_API_ID=0000000
TELEGRAM_API_HASH=cole_aqui_o_api_hash
# Gerada no primeiro login. É equivalente à sua conta: quem tem
# isto entra no seu Telegram. Nunca commite, nunca mande por chat.
TELEGRAM_SESSION=cole_aqui_a_string_de_sessao


# ---------- WhatsApp: bot que publica (D-071) ----------
# Evolution API rodando na VPS. O IP DA VPS PRECISA SER BRASILEIRO:
# número do Brasil conectado de servidor europeu é bandeira vermelha
# de primeira camada na detecção.
#
# O chip é DEDICADO, nunca o número pessoal nem o de trabalho, e o
# número do bot nunca pode ser o único admin do grupo — quando ele
# cair, é o outro admin que segura a audiência.
#
# Qual instância serve cada canal fica no banco
# (`canal.whatsapp_instancia`), não aqui: são vários chips.
WHATSAPP_API_URL=https://evolution.seudominio.com.br
WHATSAPP_API_KEY=cole_aqui_a_apikey_da_evolution


# ---------- Rotinas agendadas ----------
# Segredo que autoriza o agendador a chamar as Edge Functions.
# Gere com: openssl rand -hex 32
COLETA_SEGREDO=troque_por_uma_string_aleatoria_longa


# ---------- Redirecionador ----------
# Domínio curto que encurta e rastreia os links
URL_BASE_REDIRECIONADOR=https://go.seudominio.com.br

# Sal usado no hash do IP dos cliques (LGPD).
# Gere com: openssl rand -hex 32
# NUNCA mude depois de começar a coletar clique.
SAL_HASH_IP=troque_por_uma_string_aleatoria_longa


# ---------- Captura de telas (`pnpm telas`) ----------
# Conta de teste do banco LOCAL — nunca uma conta de verdade.
PAINEL_URL=http://localhost:3000
CONTA_DE_CAPTURA_EMAIL=voce@local.test
CONTA_DE_CAPTURA_SENHA=cole_aqui_a_senha_local


# ---------- Ambiente ----------
NODE_ENV=development
TZ=America/Sao_Paulo
